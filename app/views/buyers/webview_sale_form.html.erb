<!-- Search Input -->
<div style='font-size: small'>
  <div class='fixed-top bg-warning'>
    <div class="text-center my-3">
      <input type="text" id="pack-search" class="form-control w-50 mx-auto" placeholder="🔍 Поиск...">
    </div>

    <!-- Category Tabs -->
    <ul class="nav nav-tabs justify-content-center" id="category-tabs" style="font-size: small;">
      <li class="nav-item">
        <a class="nav-link active" data-category="all">Все</a>
      </li>
      <% @categories.each do |category| %>
        <li class="nav-item">
          <a class="nav-link" data-category="<%= category.id %>"><%= category.name %></a>
        </li>
      <% end %>
    </ul>
  </div>

  <!-- Pack List -->
  <div style='margin-top: 100px;'>
    <div class='mt-5'>
      <div class="mt-5 row row-cols-2 row-cols-sm-1 row-cols-md-2 g-3" id="pack-list">
        <% @categories.each do |category| %>
          <% category.packs.order(name: :asc).each do |pack| %>
            <div class="col pack-card" data-category="<%= category.id %>" data-name="<%= pack.name.downcase %>" data-pack-id="<%= pack.id %>">
              <div class="card h-100 shadow-sm">
                <img src="<%= asset_path("pack_#{pack.id}.png") if File.exist?(Rails.root.join("app/assets/images/pack_#{pack.id}.png")) %>"
                     class="card-img-top" alt="<%= pack.name %>">
                <div class="card-body text-center">
                  <span class="card-title fw-bold"><%= pack.name %></span>
                  <p class="card-text text-success fw-bold">💰 <%= num_to_usd pack.sell_price %></p>
                  <div class="d-flex justify-content-center align-items-center gap-1 mb-2">
                    <button type="button" class="btn btn-sm btn-outline-danger change-qty" data-pack-id="<%= pack.id %>" data-change="-1">-</button>
                    <input type="number" class="form-control text-center qty-input" data-pack-id="<%= pack.id %>" value="0" min="0" style="width: 65px;">
                    <button type="button" class="btn btn-sm btn-outline-success change-qty" data-pack-id="<%= pack.id %>" data-change="1">+</button>
                  </div>
                  <div class="d-flex justify-content-center align-items-center gap-2">
                    <input type="number"
                           class="form-control text-center box-input"
                           placeholder="коробок"
                           min="0"
                           data-pack-id="<%= pack.id %>"
                           data-amount-per-pack="<%= pack.amount_per_pack || 1 %>"
                           style="width: 85px; font-size: 13px;">
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Summary -->
  <div id="summary" class="bg-white p-3 mb-5 pb-5 shadow border-top">
    <ul id="selected-items" class="list-unstyled text-center"></ul>
    <button id="submit-sale" class="fixed-bottom btn btn-success w-100">✅ Oформить продажу <span id="total-price">0</span></button>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  let cart = {};
  let selectedCategory = "all";

  function filterPacks() {
    const searchText = document.querySelector("#pack-search").value.toLowerCase();
    document.querySelectorAll(".pack-card").forEach(card => {
      const matchesCategory = (selectedCategory === "all" || card.getAttribute("data-category") === selectedCategory);
      const matchesSearch = card.getAttribute("data-name").includes(searchText);
      card.style.display = (matchesCategory && matchesSearch) ? "block" : "none";
    });
  }

  // Category tabs
  document.querySelectorAll("#category-tabs .nav-link").forEach(tab => {
    tab.addEventListener("click", function () {
      selectedCategory = this.getAttribute("data-category");
      document.querySelectorAll("#category-tabs .nav-link").forEach(link => link.classList.remove("active"));
      this.classList.add("active");
      filterPacks();
    });
  });

  // Search input
  document.querySelector("#pack-search").addEventListener("input", filterPacks);

  // Quantity +/- buttons
  document.querySelectorAll(".change-qty").forEach(button => {
    button.addEventListener("click", function () {
      let packId = this.getAttribute("data-pack-id");
      let input = document.querySelector(`.qty-input[data-pack-id='${packId}']`);
      let newQty = Math.max(0, (parseInt(input.value) || 0) + parseInt(this.getAttribute("data-change")));
      input.value = newQty;
      updateCart(packId, newQty);
    });
  });

  // Manual quantity input
  document.querySelectorAll(".qty-input").forEach(input => {
    input.addEventListener("input", function () {
      let packId = this.getAttribute("data-pack-id");
      updateCart(packId, Math.max(0, parseInt(this.value) || 0));
    });
  });

  // Box input logic
  document.querySelectorAll(".box-input").forEach(boxInput => {
    boxInput.addEventListener("input", function () {
      let packId = this.getAttribute("data-pack-id");
      let amountPerPack = parseInt(this.getAttribute("data-amount-per-pack")) || 1;
      let boxCount = parseInt(this.value) || 0;
      let calculatedQty = boxCount * amountPerPack;
      let qtyInput = document.querySelector(`.qty-input[data-pack-id='${packId}']`);
      qtyInput.value = calculatedQty;
      updateCart(packId, calculatedQty);
    });
  });

  function updateCart(packId, qty) {
    if (qty > 0) {
      cart[packId] = qty;
    } else {
      delete cart[packId];
    }
    updateSummary();
  }

  function updateSummary() {
    let total = 0;
    let itemList = "";
    Object.keys(cart).forEach(id => {
      let card = document.querySelector(`.pack-card[data-pack-id='${id}']`);
      let name = card.querySelector(".card-title").innerText;
      let price = parseFloat(card.querySelector(".card-text").innerText.replace(/[^\d.]/g, '')) || 0;
      total += price * cart[id];
      itemList += `<li>${name}: ${cart[id]} шт.</li>`;
    });

    document.querySelector("#total-price").textContent = total.toLocaleString();
    document.querySelector("#selected-items").innerHTML = itemList;
  }

  document.querySelector("#submit-sale").addEventListener("click", function () {
    const [_, buyers, buyerId, __, telegramChatId] = window.location.pathname.split("/");
    fetch("/sales/webview", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        sale: cart,
        buyer_id: buyerId,
        telegram_chat_id: telegramChatId
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        window.location.href = "/sale_completed";
      } else {
        alert("❌ Ошибка.");
      }
    })
    .catch(() => alert("❌ error."));
  });
});
</script>

<style>
  .nav-tabs .nav-link {
    font-size: 14px;
    padding: 8px 12px;
    cursor: pointer;
  }

  .card-img-top {
    height: 120px;
    object-fit: cover;
  }

  .qty-input, .box-input {
    width: 60px;
    text-align: center;
    font-size: 13px;
  }

  .box-input::placeholder {
    font-size: 12px;
    color: #888;
  }

  #summary {
    background-color: #fff;
  }

  @media (max-width: 768px) {
    .row-cols-md-3 > * {
      flex: 0 0 33.33%;
      max-width: 33.33%;
    }
  }
</style>
