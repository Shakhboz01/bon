<div class="container shadow-lg">
  <%= render 'form_filter_form' %>
</div>
<br><br><br>
<div class="mb-3">
  <%= link_to '📥 Export to Excel',
    export_excel_sale_portions_path(format: :xlsx, q: params[:q]&.to_unsafe_h, q_other: { agent_user_id_eq: params.dig(:q, :agent_user_id_eq) }),
    method: :get,
    class: 'btn btn-success' %>

</div>
<div class='mb-5 card shadow bg-info'>
  <h1>Список для склада</h1>
  <%=  render 'sales/product_sells_total_info', sales: @sales, total_price: @total_price, grouped_packs: @grouped_packs %>
</div>
<div class='d-flex flex-column'>
  <% @sales.each do |sale| %>
    <%= render 'sales/receipt', sale: sale, enable_to_edit: true %>
  <% end %>
</div>
