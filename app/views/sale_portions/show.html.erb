<ul>
  <li>От: <%= strf_datetime @sale_portion.from %></li>
  <li>До: <%= strf_datetime @sale_portion.till %></li>
  <li>Итого сумма: <%= num_to_usd @sale_portion.total_price %></li>
  <li>Aгент: <%= @sale_portion.user&.name %></li>
</ul>

<div class='bg-info'>
  <%=  render 'sales/product_sells_total_info', sales: @sales, total_price: @total_price, grouped_packs: @grouped_packs %>
</div>
<br>
<div class='d-flex flex-column'>
  <% @sales.each do |sale| %>
    <%= render 'sales/receipt', sale: sale %>
  <% end %>
</div>
